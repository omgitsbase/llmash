1 ICON "@LLMASH_ICON@"

1 VERSIONINFO
FILEVERSION     @LLMASH_VERSION_COMMAS@
PRODUCTVERSION  @LLMASH_VERSION_COMMAS@
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "llmash"
      VALUE "FileDescription",  "llmash"
      VALUE "FileVersion",      "@LLMASH_VERSION@"
      VALUE "InternalName",     "llmash"
      VALUE "OriginalFilename", "@LLMASH_EXE@"
      VALUE "ProductName",      "llmash"
      VALUE "ProductVersion",   "@LLMASH_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
